# Secrets
.env
.env.*
!.env.example

# Python / uv
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# Notebooks
.ipynb_checkpoints/

# Data: images and large artifacts are released separately
data/raw/
data/images/
data/crops/
*.jpg
*.jpeg
*.png
*.webp
*.sqlite
*.sqlite3
*.db
*.parquet
*.jsonl
checkpoints/

# Model weights / caches
models/
hf_cache/

# OS / editor
.DS_Store
.vscode/
.idea/

# Large raw API dumps (regenerable with scripts/phase0_*.py)
data/**/detections.json
data/**/map_features.json
*.log
data/collect/**/thumb_crops/

# Phase 0 probe outputs (regenerable; numbers go in the README instead)
data/phase0/

# Phase 1 intermediates (regenerable); keep only triage.csv and <area>/candidates.csv
data/collect/**/dedup.csv
data/collect/sheets/

# Labels are hand work: always track them
!data/labels/labels.sqlite

# OCR audit cache: regenerable with scripts/audit_labels.py --reocr
data/labels/ocr_cache.json

# Phase 6 tables and figures: regenerated in about a second by scripts/analyze.py from tracked data, and the
# figures are embedded in notebooks/03_results.ipynb. Hand-tagged error sheets belong in data/labels/.
reports/

# Model outputs. The answers themselves are tracked: regenerating them means renting a GPU, and at
# 3-5 MB per run they're small. Ignore the directory's *contents*, not the directory, or git can't
# re-include anything inside it; the negation must also come after the global *.jsonl rule above.
# (A bracket class like *_[AB].jsonl failed to match here on macOS, so the dry-run previews are
# re-ignored by name instead.) cache.sqlite stays ignored (*.sqlite): same answers, keyed for resuming.
data/runs/*
!data/runs/*.jsonl
data/runs/prompts_*

# The query set is small and derived deterministically from the labels; keep it for reproducibility.
# Negating the directory is not enough: *.parquet above still matches the files inside it, so the
# files themselves have to be un-ignored by name.
!data/queries/
!data/queries/*.parquet
