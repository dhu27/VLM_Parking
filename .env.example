# Copy this file to .env and fill in the values. Never commit .env.

# Phase 0-1: Mapillary API client token (starts with "MLY|")
# https://www.mapillary.com/dashboard/developers
MAPILLARY_TOKEN=

# Phase 3: frontier API model used as the pre-fill labeler (not one of the evaluated models)
# LABELER_API_KEY=

# Phase 5: Hugging Face token for downloading model weights
# HF_TOKEN=

# Phase 5: RunPod API key for GPU rental
# RUNPOD_API_KEY=
